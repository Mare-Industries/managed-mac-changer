#!/usr/bin/env bash
# managed-mac-changer — main CLI entry point
set -euo pipefail
IFS=$'\n\t'

INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="${INSTALL_DIR}/lib"
# Allow override via env var; default to the installed config location
CONFIG_DIR="${MANAGED_MAC_CHANGER_CONFIG_DIR:-/etc/managed-mac-changer}"

source "${LIB_DIR}/config.sh"
source "${LIB_DIR}/hostname.sh"
source "${LIB_DIR}/mac.sh"

usage() {
  cat <<EOF
managed-mac-changer — randomize hostname and MAC address

Usage:
  sudo managed-mac-changer [OPTIONS]

Options:
  randomize            Randomize both hostname and MAC (default)
  restore              Restore backed-up hostname and MAC
  --dry-run            Preview changes without applying
  --group GROUP        Use a specific MAC group
  --interface, -i IF   Specify network interface (auto-detected if omitted)
  --hostname-only      Only randomize hostname
  --mac-only           Only randomize MAC
  web                  Start the web configuration UI
  status               Show current hostname and MAC
  --help, -h           Show this help

Examples:
  sudo managed-mac-changer
  sudo managed-mac-changer --dry-run
  sudo managed-mac-changer --group home
  sudo managed-mac-changer restore
  managed-mac-changer web
  managed-mac-changer status
EOF
  exit 0
}

cmd_status() {
  local iface; iface=$(detect_interface 2>/dev/null || echo "none")
  echo ""
  echo "  Hostname  : $(hostname)"
  echo "  Interface : ${iface}"
  if [[ "$iface" != "none" ]]; then
    echo "  MAC       : $(get_current_mac "$iface")"
  fi
  local active_groups; active_groups=$(get_active_groups)
  echo "  Groups    : ${active_groups:-none configured}"
  echo ""
}

cmd_web() {
  local web_dir="${INSTALL_DIR}/web"
  local server="${web_dir}/server.py"
  if ! command -v python3 &>/dev/null; then
    echo "Error: python3 is required for the web UI." >&2
    exit 1
  fi
  if [[ ! -f "$server" ]]; then
    echo "Error: web server not found at ${server}" >&2
    exit 1
  fi
  echo "Starting web UI at http://localhost:7779 ..."
  exec python3 "$server" --config-dir "${CONFIG_DIR}"
}

main() {
  local mode="randomize"
  local dry_run=false
  local group=""
  local iface=""
  local hostname_only=false
  local mac_only=false

  [[ $# -eq 0 ]] && mode="randomize"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      randomize)       mode="randomize" ;;
      restore)         mode="restore" ;;
      web)             cmd_web ;;
      status)          cmd_status; exit 0 ;;
      --dry-run)       dry_run=true ;;
      --group)         shift; group="$1" ;;
      --interface|-i)  shift; iface="$1" ;;
      --hostname-only) hostname_only=true ;;
      --mac-only)      mac_only=true ;;
      --help|-h)       usage ;;
      *)               echo "Unknown argument: $1" >&2; usage ;;
    esac
    shift
  done

  # Auto-detect interface
  [[ -z "$iface" ]] && iface=$(detect_interface)

  if $dry_run; then
    local new_host; new_host=$(generate_hostname)
    local new_mac; new_mac=$(pick_mac "$group")
    echo ""
    echo "  Dry-run preview:"
    echo "    Hostname  : $(hostname) → ${new_host}"
    echo "    Interface : ${iface}"
    echo "    MAC       : $(get_current_mac "$iface") → ${new_mac}"
    [[ -n "$group" ]] && echo "    Group     : ${group}"
    echo ""
    exit 0
  fi

  [[ $EUID -eq 0 ]] || { echo "Error: run as root (sudo)." >&2; exit 1; }

  init_log

  case "$mode" in
    restore)
      $mac_only     || do_restore_hostname
      $hostname_only || do_restore_mac "$iface"
      ;;
    randomize)
      $mac_only     || do_randomize_hostname
      $hostname_only || do_randomize_mac "$iface" "$group"
      ;;
  esac
}

main "$@"
