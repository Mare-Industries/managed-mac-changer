[Unit]
Description=managed-mac-changer — randomize hostname and MAC on boot
After=local-fs.target network-pre.target
Before=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash __INSTALL_DIR__/bin/managed-mac-changer randomize
RemainAfterExit=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
