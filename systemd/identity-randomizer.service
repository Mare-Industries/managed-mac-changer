[Unit]
Description=identity-randomizer — randomize hostname and MAC on boot
After=network-pre.target
Before=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash __INSTALL_DIR__/bin/identity-randomizer randomize
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
